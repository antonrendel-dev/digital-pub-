#!/bin/sh

export PATH="$HOME/.local/bin:$PATH"

# 1. Scan for secrets
gitleaks protect --staged --no-banner
if [ $? -ne 0 ]; then
  echo "❌ gitleaks: secrets detected — commit blocked"
  exit 1
fi

# 2. Lint + format staged files
# Код возврата проверяется явно: 26.08.2026 lint-staged упал на файле с any,
# откатил свои правки — и коммит всё равно ушёл в main, потому что дальше
# скрипт просто продолжался. Падение линтера должно останавливать коммит.
npx lint-staged
if [ $? -ne 0 ]; then
  echo "❌ lint-staged: правки не прошли линтер — commit blocked"
  exit 1
fi

# 3. Types must compile — иначе сломанный код уезжает в пуш,
# а падает уже CI. Так было 25.08.2026: eslint и prettier прошли,
# tsc никто не звал, и коммит с несуществующей переменной ушёл в main.
echo "⏳ tsc..."
npx tsc --noEmit
if [ $? -ne 0 ]; then
  echo "❌ tsc: типы не сходятся — commit blocked"
  exit 1
fi

# 3б. Скрипты — отдельным конфигом: основной tsconfig исключает scripts/**,
# и «tsc чистый» их не покрывал вовсе. 02.09.2026 из-за этого в main ушли
# два сломанных импорта подряд: boost.ts падал на первом кандидате, writer.ts
# звал stripRoleTag без импорта. Бандлер оба случая пропустил молча.
echo "⏳ tsc (scripts)..."
npx tsc --noEmit -p tsconfig.scripts.json
if [ $? -ne 0 ]; then
  echo "❌ tsc(scripts): типы не сходятся — commit blocked"
  exit 1
fi

# 4. Новые статьи — только под ключ из ядра (аудит 04.09.2026, O11). Завод пишет
# файлы через fs и коммитит git-ом, PostToolUse-хук Claude его не видит — поэтому
# проверка здесь. Пока ядра scripts/content-factory/data/core-*.json нет (O1),
# печатается напоминание без блокировки.
NEW_MDX=$(git diff --cached --name-only --diff-filter=A -- 'content/articles/*.mdx')
if [ -n "$NEW_MDX" ]; then
  CORE=$(ls scripts/content-factory/data/core-*.json 2>/dev/null | tail -1)
  if [ -z "$CORE" ]; then
    echo "ℹ️  Новые статьи в коммите ($(echo "$NEW_MDX" | wc -l)); ядра core-*.json пока нет (O1) — проверка ключа пропущена"
  else
    for f in $NEW_MDX; do
      KEY=$(grep -oE '"keywords":"[^,"]+' "$f" | head -1 | sed 's/"keywords":"//')
      if [ -z "$KEY" ] || ! jq -e --arg k "$KEY" '.. | strings | select(test("^" + $k + "$"; "i"))' "$CORE" >/dev/null 2>&1; then
        echo "❌ $f: ключ «$KEY» не из ядра $(basename "$CORE") — commit blocked (стоп-лист O11)"
        exit 1
      fi
    done
  fi
fi
