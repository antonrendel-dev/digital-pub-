{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/claude/.truthguard/scripts/pre-commit-tests.sh",
            "timeout": 120,
            "statusMessage": "TruthGuard: running tests before commit..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/memory-rules.sh",
            "timeout": 15,
            "statusMessage": "Проверка правил проекта..."
          }
        ]
      }
    ]
  }
}
