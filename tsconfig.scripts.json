{
  // Основной tsconfig исключает scripts/** — из-за этого «tsc чистый» четыре
  // круга подряд не покрывал ни завод, ни дожим, и раннер уехал в коммит
  // с ненайденными импортами (ревью 02.09.2026). Здесь тайпчек именно скриптов.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    // es2022 — ради top-level await в warm-lsi-cache.ts. Базовый конфиг
    // держит es2015, и без этого единственный скрипт завода оставался бы
    // вне гейта, то есть та же дыра, только тише.
    "target": "es2022"
  },
  "include": ["scripts/content-factory/**/*.ts", "scripts/seo-audit/**/*.ts", "lib/**/*.ts"],
  "exclude": ["node_modules", "scripts/**/*.compiled.js", "scripts/content-factory/dist"]
}
